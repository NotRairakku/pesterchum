{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pesterchum",
  "version": "0.1.0",
  "identifier": "com.notrairakku.pesterchum",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "window": {
      "all": true
    }
  },
  "app": {
    "windows": [
      {
        "title": "Pesterchum 6.0",
        "width": 460,
        "height": 810,
        "decorations": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null
    }
  }
}
